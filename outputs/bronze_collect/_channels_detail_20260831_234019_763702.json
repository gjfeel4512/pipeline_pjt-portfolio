        "default": {
          "url": "https://yt3.ggpht.com/5kHJkb6OCZ69WAzh5IrREZyoxUgP_zHjGaoSHG31QAs5b4z_WRMdJko7S0djIQTj0KmI6jDY=s88-c-k-c0x00ffffff-no-rj",
